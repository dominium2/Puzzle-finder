    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT locationID as id, name, latitude as lat, longitude as lng, COALESCE(hints, puzzle_text, description) as clue FROM Locations WHERE is_active = TRUE AND locationID = {{ COALESCE($('Get Progress').first().json.currentStep, 0) + 1 }} LIMIT 1;",
