    {
      "parameters": {
        "jsCode": "const progress = $('Get Progress').first().json;\nconst total = Number($('Get Total').first().json.total || 0);\nconst currentStep = Number(progress.currentStep || 0);\nconst currentLocation = $('Get Current Location').first().json || {};\nconst currentTargetId = String(currentLocation.id ?? currentStep + 1);\nconst currentMission = currentLocation.name\n  ? `Head to ${currentLocation.name}. ${currentLocation.clue || currentLocation.base_clue || currentLocation.hints || ''}`.trim()\n  : `Head to the next location.`;\n\nreturn {\n  currentTargetId,\n  currentMission,\n  progress: {\n    completed: currentStep,\n    total\n  },\n  unlockedLocations: Array.from({ length: currentStep }, (_, i) => String(i + 1)),\n  selectedLocationId: currentTargetId\n};"
      },
